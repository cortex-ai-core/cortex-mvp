{
  "namespace": "core",
  "namespaceId": "d5068743-69e8-4c1d-af36-151e7afc9fa6",
  "otherNamespaceId": "f3e2f9e4-30f0-4343-9dec-2c347136c766",
  "notes": "Multi-turn scenarios for the memory work (design doc 5.11). Each scenario is one conversation unless a turn sets new_conversation; turns are sent in order with the conversationId the server returns. A turn's `as` picks the login: primary (default, EVAL_EMAIL), second (EVAL_EMAIL_2, same namespace; scenario is skipped when unset), other_namespace (the primary account signed into otherNamespaceId). {{marker}} in a message is replaced by a random token per run so seeded facts are unique. expect.cites_any: at least one citation's file or display name contains one of these substrings (case-insensitive). expect.answer_must_include / answer_must_not_include: substrings of the answer ({{marker}} allowed). expect.mode_in: the answer mode must be one of these. expect.not_abstain: the answer must not be a 'documents don't cover this' reply. expect.abstain: it must be one (guards against general-knowledge leaks). expect.memory_saved: a memory was saved this turn. expect.memories_used_min / memories_used_max: bounds on the memories the answer used. expect.saved_memory_fetch: 'ok' or '404' when fetching the memory saved earlier in the scenario as this turn's login. expect.memory_action_in: the saved memory's action (created, superseded, duplicate) must be one of these. expect.extracted_min / extracted_max: bounds on the memories automatic extraction wrote from this turn, read from the turn's trace once extraction has finished (needs migration 0009). A turn with action 'delete_saved_memory' instead of a message deletes the memory saved most recently in the scenario, as that login. needs_extraction: the scenario is skipped unless extraction is on for the namespace (MEMORY_EXTRACT_ENABLED=1 or the memory_settings row). Memories saved or extracted during a scenario are deleted afterwards. family: follow-up (Phase 2), carry-over and isolation (Phase 3), forget-correct and extraction (Phase 4), administration (later).",
  "scenarios": [
    {
      "id": "follow-001",
      "family": "follow-up",
      "turns": [
        {
          "message": "Which documents cover the internship program?",
          "expect": {
            "cites_any": [
              "Internship"
            ],
            "not_abstain": true
          }
        },
        {
          "message": "Summarise the second one",
          "expect": {
            "cites_any": [
              "Internship"
            ],
            "not_abstain": true,
            "mode_in": [
              "retrieval",
              "document"
            ]
          }
        }
      ]
    },
    {
      "id": "follow-002",
      "family": "follow-up",
      "turns": [
