
# Ingestion
PARSER_URL=http://localhost:8090
PARSER_SECRET=
PARSER_TIMEOUT_MS=600000
MAX_UPLOAD_MB=50
EMBED_MODEL=text-embedding-3-small
EMBED_BATCH=64
INGEST_POLL_MS=2000
INGEST_STALE_MINUTES=2           # a document mid-ingest with no worker heartbeat this long is requeued (failed after 3 attempts)

# Retrieval
RETRIEVAL_MODE=hybrid            # hybrid (needs migration 0004) | legacy
ALLOW_RETRIEVAL_MODE_OVERRIDE=0  # 1 lets the X-Retrieval-Mode header pick per request (eval only)
RETRIEVAL_TRACE=on

# Memory (design doc 5.12). All off/safe by default; a namespace row in memory_settings overrides.
MEMORY_ENABLED=0
MEMORY_HISTORY_ENABLED=1
MEMORY_RECALL_ENABLED=1
MEMORY_EXTRACT_ENABLED=0
# automatic extraction (hook H6) gives up on a slow model call after this many ms
MEMORY_EXTRACT_TIMEOUT_MS=25000
# list prices per million tokens for the cost-per-turn figure (backend/lib/usage.js has the defaults);
# e.g. {"gpt-5.1":{"input":1.25,"output":10}}
MODEL_PRICES_JSON=
MEMORY_NAMESPACES=
MEMORY_EXTRACT_MODEL=gpt-5-mini
MEMORY_HISTORY_TURNS=10
MEMORY_HISTORY_TOKENS=2000
MEMORY_SUMMARY_TRIGGER_TOKENS=3000
MEMORY_RECALL_K=8
MEMORY_RECALL_MIN_SIM=0.35
MEMORY_BLOCK_TOKENS=600
MEMORY_MAX_ACTIVE_PER_USER=500
MEMORY_RETENTION_DAYS=0

# Chat retention (migration 0013). Archive summaries are written by this
# model; a call that runs past the timeout is deferred to the next sweep,
# and after RETENTION_ARCHIVE_ATTEMPTS failures the thread is archived with
# a metadata-only record so retention never stalls.
RETENTION_SUMMARY_MODEL=gpt-5-mini
RETENTION_ARCHIVE_TIMEOUT_MS=45000
RETENTION_ARCHIVE_ATTEMPTS=3
# Days since a thread's last message before it is summarised and purged when
# neither the organization (chat_retention_days) nor the namespace
# (memory_settings.retention_days) says otherwise. 0 keeps forever.
CHAT_RETENTION_DAYS=30
# The in-process sweep: how often it runs (0 disables it; set 0 on dev
# machines and for eval runs), how many threads per pass, and the age after
# which thread-less trace text is nulled (blank = the same as the chat days).
RETENTION_SWEEP_MINUTES=60
RETENTION_SWEEP_BATCH=50
RETENTION_TRACE_DAYS=
# Daily mode instead of the interval: one pass a day at this wall-clock time
# in this IANA zone, looping in batches until nothing is due. Leave
# RETENTION_SWEEP_AT blank to keep the interval.
RETENTION_SWEEP_AT=02:00
RETENTION_SWEEP_TZ=America/Los_Angeles
MEMORY_NEAR_DUP_SIM=0.92

# Eval login (Supabase Auth user with access to the golden namespace)
EVAL_EMAIL=
EVAL_PASSWORD=
# a second account in the same namespace, for the isolation scenarios (npm run eval -- --memory); optional
EVAL_EMAIL_2=
EVAL_PASSWORD_2=

# Intent module (backend/reasoning/intent.js): one small-model classification per message
INTENT_MODE=model
INTENT_MODEL=gpt-5-mini
INTENT_TIMEOUT_MS=4000

# Persona / PCL (section 4.4). 0 forces the built-in default for every turn
# (no persona, no user note); the reply and trace say source "default".
PCL_ENABLED=1
