{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCortexDocuments",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::cortex-documents-dev-909762691423"
    },
    {
      "Sid": "ManageCortexDocumentFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::cortex-documents-dev-909762691423/*"
    }
  ]
}
